# Which businesses/<slug>/ directory to use (see businesses/ and README
# "Adding another business"). Defaults to the only directory under
# businesses/ if there's exactly one.
BUSINESS_SLUG=brows-and-threading-city

CONFIDENCE_THRESHOLD=0.85
GOOGLE_CLIENT_MODE=mock
SLACK_WEBHOOK_URL=

# Which agentic harness runs review-handler.md's instructions for unattended
# runs (scripts/run_review_handler.sh) - see docs/ARCHITECTURE.md "Harness
# layer". claude-code is the only one implemented today; a future harness
# is a new scripts/harnesses/<name>.sh, selected by setting this.
AGENT_HARNESS=claude-code

# Only needed once GOOGLE_CLIENT_MODE=live (see docs/API_SETUP.md).
# Account-level OAuth credentials — same for every business the
# authorizing Google account manages. Per-business google_account_id /
# google_location_id live in businesses/<slug>/business.json instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
