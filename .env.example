# Which businesses/<slug>/ directory to use (see businesses/ and README
# "Adding another business"). Defaults to the only directory under
# businesses/ if there's exactly one.
BUSINESS_SLUG=brows-and-threading-city

CONFIDENCE_THRESHOLD=0.85
GOOGLE_CLIENT_MODE=mock
SLACK_WEBHOOK_URL=

# Which agentic harness runs review-handler.md's instructions for unattended
# runs (scripts/run_review_handler.sh) - see docs/ARCHITECTURE.md "Harness
# layer". claude-code is the only one implemented today; a future harness
# is a new scripts/harnesses/<name>.sh, selected by setting this.
AGENT_HARNESS=claude-code

# Only needed once GOOGLE_CLIENT_MODE=live (see docs/API_SETUP.md).
# Account-level OAuth credentials — same for every business the
# authorizing Google account manages. Per-business google_account_id /
# google_location_id live in businesses/<slug>/business.json instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Only needed to run webapp/ (the self-serve live demo - see
# docs/ARCHITECTURE.md "Demo layer"). This is a SEPARATE OAuth client from
# GOOGLE_OAUTH_CLIENT_ID above: that one is a Desktop-app client used by a
# human running tools/google_oauth_setup.py on their own machine; this one
# is a Web-application client with a real HTTPS redirect URI, used by a
# browser flow for a visitor authorizing their own Business Profile. Don't
# reuse one client for both - they're registered as different types in
# Google Cloud Console.
GOOGLE_WEB_OAUTH_CLIENT_ID=
GOOGLE_WEB_OAUTH_CLIENT_SECRET=
# Current public HTTPS URL of the demo server (e.g. your ngrok/Cloudflare
# Tunnel URL) - must exactly match the redirect URI registered on the Web
# OAuth client above. Changes every time a free tunnel restarts.
DEMO_PUBLIC_BASE_URL=
